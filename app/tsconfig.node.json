{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // The root-level build configs. They import bundler-published packages
  // (@tailwindcss/vite, vitest/config, @playwright/test) that the app's own
  // "moduleResolution": "node" cannot resolve, so they get their own program.
  // Run by the "typecheck" script alongside the root config; nothing here
  // applies to src/ (the stricter flags above would cascade errors there).
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
